
#
# Preferences
#
preferences set plugin-enable-svdatabrowser-new 1
preferences set plugin-enable-groupscope 0
preferences set sb-display-values 1
preferences set plugin-enable-interleaveandcompare 0
preferences set plugin-enable-waveformfrequencyplot 0
preferences set savedlg-simulator ppe

#
# Databases
#
database require waves -search {
	./waves.shm/waves.trn
	/home/luu_k64/Vivado/DNN_core/DNN_core.srcs/sources_1/new/waves.shm/waves.trn
}
#
# Groups
#
catch {group new -name PE0_0 -overlay 0}
catch {group new -name PE0_1 -overlay 0}
catch {group new -name PE0_2 -overlay 0}
group using PE0_0
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    waves::PE_array_tb.dut.row[0].col[0].pe_inst.clk \
    waves::PE_array_tb.dut.row[0].col[0].pe_inst.enable \
    waves::PE_array_tb.dut.row[0].col[0].pe_inst.reset_pe_1 \
    waves::PE_array_tb.dut.row[0].col[0].pe_inst.reset_pe_2 \
    waves::PE_array_tb.dut.row[0].col[0].pe_inst.sel_out_de_mux \
    waves::PE_array_tb.dut.row[0].col[0].pe_inst.sel_out_mux
group using PE0_1
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    waves::PE_array_tb.dut.row[0].col[1].pe_inst.clk \
    waves::PE_array_tb.dut.row[0].col[1].pe_inst.enable \
    waves::PE_array_tb.dut.row[0].col[1].pe_inst.reset_pe_1 \
    waves::PE_array_tb.dut.row[0].col[1].pe_inst.reset_pe_2 \
    waves::PE_array_tb.dut.row[0].col[1].pe_inst.sel_out_de_mux \
    waves::PE_array_tb.dut.row[0].col[1].pe_inst.sel_out_mux \
    waves::PE_array_tb.dut.row[0].col[1].pe_inst.write_out_en \
    waves::PE_array_tb.dut.row[0].col[1].pe_inst.mac_out[15:0]
group using PE0_2
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    waves::PE_array_tb.dut.row[0].col[2].pe_inst.clk \
    waves::PE_array_tb.dut.row[0].col[2].pe_inst.enable \
    waves::PE_array_tb.dut.row[0].col[2].pe_inst.reset_pe_1 \
    waves::PE_array_tb.dut.row[0].col[2].pe_inst.reset_pe_2 \
    waves::PE_array_tb.dut.row[0].col[2].pe_inst.sel_out_de_mux \
    waves::PE_array_tb.dut.row[0].col[2].pe_inst.sel_out_mux \
    waves::PE_array_tb.dut.row[0].col[2].pe_inst.write_out_en \
    waves::PE_array_tb.dut.row[0].col[2].pe_inst.mac_out[15:0] \
    waves::PE_array_tb.dut.row[0].col[2].pe_inst.result_1[15:0] \
    waves::PE_array_tb.dut.row[0].col[2].pe_inst.result_2[15:0]

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1920x1003+0+24}] != ""} {
    window geometry "Waveform 1" 1920x1003+0+24
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar select designbrowser
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 175 \
    -units ns \
    -valuewidth 75
waveform baseline set -time 0


set groupId0 [waveform add -groups PE0_0]
waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups PE0_1]
waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups PE0_2]
waveform hierarchy collapse $groupId0


waveform xview limits 0 3150ns

#
# Waveform Window Links
#

#
# Console windows
#
console set -windowname Console
window geometry Console 600x250+0+53

