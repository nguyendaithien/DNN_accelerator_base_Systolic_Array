if {[catch {window new SrcBrowser -name "Source Browser 2" -geometry 700x525+0+53}] != ""} {
    window geometry "Source Browser 2" 700x525+0+53
}
window target "Source Browser 2" on
srcbrowser using {Source Browser 2}
srcbrowser set \
    -primarycursor TimeA \
    -units ns \
    -radix default \
    -showstrength 0 \
    -showcallstack 0 \
    -displayvalues 1

srcbrowser show -scope tb_buffer_array -file /home/luu_k64/Vivado/DNN_core/DNN_core.srcs/sources_1/new_1/test_buffer_array/tb.sv -line 3

srcbrowser sidebar visibility partial

#
# Console windows
